# The typography bench, under the robix service naming.
#
#   sudo install -m644 deploy/ambient-display.nginx \
#       /etc/nginx/sites-available/display.robix
#   sudo ln -s /etc/nginx/sites-available/display.robix /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# A bench for tuning type from a laptop, not a public service. When the client
# moves to Bloopy, either point proxy_pass at bloopy and keep serving it from
# robix under this name, or install this on Bloopy and rename the server to
# display.bloopy.

server {
    listen 80;
    server_name display.robix;

    access_log /var/log/nginx/display.robix.access.log;
    error_log  /var/log/nginx/display.robix.error.log;

    location / {
        proxy_pass http://127.0.0.1:8324;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Frames are regenerated every tick and the page cache-busts its own
        # requests; never let anything in between hold one.
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        add_header Cache-Control "no-store" always;
    }
}
