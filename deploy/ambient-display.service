# systemd *user* service, matching ambient-mixer on robix.
#
# It runs the same process on both machines. On robix `display.device` stays
# "noop": there is no panel here, so the client subscribes, composes frames and
# serves the preview, which is exactly the deploy minus the last inch. On
# Bloopy set `display.device` to "ssd1351" in config.json and add the user to
# the spi and gpio groups -- a user service runs as that user and inherits the
# groups, so the unit itself doesn't change.
#
# `loginctl enable-linger rcampbell` (already set on robix for the mixer)
# starts it at boot with nobody logged in.
#
#   install -Dm644 deploy/ambient-display.service \
#       ~/.config/systemd/user/ambient-display.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now ambient-display
#   journalctl --user -u ambient-display -f

[Unit]
Description=ambient-display placard client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/rcampbell/ambient-display
ExecStart=/home/rcampbell/ambient-display/.venv/bin/python -m ambient_display
Environment=PYTHONUNBUFFERED=1
# So the client and the stop notifier can read their own NRestarts without the
# unit name being written down in two places. %n is the full unit name.
Environment=AMBIENT_UNIT=%n

# THE ONLY THING PRESENT AT A START THAT NEVER COMPLETES. The heartbeat in
# health.py is built in app.main, after config.load and after device.make --
# so a bad config.json or a panel that will not initialise kills the process
# before any instrument inside it exists, and the placard's own entities sit
# on their last retained values looking well. That is what jungler did for 23
# hours and 291 restarts on 2026-09-03.
#
# ExecStopPost runs after EVERY stop, including one where ExecStart died in
# its first second, so this is where a failed start can be made to say so.
#
# The `-` is not decoration: it makes systemd ignore a non-zero exit from the
# notifier. A broker that is down must not convert a failed start into a
# differently failed start.
#
# Called through the venv interpreter, not by shebang: paho is the venv's, and
# a shebang would reach the system python3, which does not have it.
ExecStopPost=-/home/rcampbell/ambient-display/.venv/bin/python /home/rcampbell/ambient-display/deploy/display-stop-notify

# always, not on-failure. SIGTERM makes the client exit 0 -- it blanks the
# panel and returns cleanly -- so a session teardown or a stray kill looks like
# success, and on-failure would leave the frame dark until someone noticed.
Restart=always
RestartSec=5

# The client blanks the panel on the way out; give it room to finish.
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=default.target
